generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String?
  phone          String?
  isReseller     Boolean  @default(false)
  resellerStatus String   @default("NONE")
  resellerPaymentStatus String @default("UNPAID")
  resellerPaymentToken  String? @unique
  isAdmin        Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
}

model Service {
  id            String  @id @default(cuid())
  name          String
  description   String
  price         Int
  resellerPrice Int
  active        Boolean @default(true)
  sortOrder     Int     @default(0)
  orders        Order[]
  serviceType   String  @default("UNBLOCK_IMEI")
}

model Order {
  id              String   @id @default(cuid())
  code            String   @unique
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  guestToken      String?  @unique
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  imei            String
  waNumber        String
  price           Int
  isResellerOrder Boolean  @default(false)
  status          String   @default("MENUNGGU_PEMBAYARAN")
  whatsappNotifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ceirResult      CeirResult?
}

model CeirResult {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  operator    String?
  result      String
  processedAt DateTime @default(now())
  processedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id               String  @id @default("main")
  telegramBotToken String?
  telegramChatId   String?
  qrisImage        String?
  tgOffset         Int     @default(0)
}
